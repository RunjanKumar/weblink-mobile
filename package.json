{
  "name": "weblinkmobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:tv": "react-native run-android --appId com.weblinkmobile",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "build:android": "cd android && gradlew assembleRelease",
    "apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "apk:install": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Install",
    "web": "webpack serve --mode development",
    "web:build": "webpack --mode production",
    "ipk": "powershell -ExecutionPolicy Bypass -File scripts/build-ipk.ps1",
    "ipk:install": "powershell -ExecutionPolicy Bypass -File scripts/build-ipk.ps1 -Install",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@tanstack/react-query": "^5.62.7",
    "axios": "^1.7.9",
    "nativewind": "4.1.23",
    "react": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "2.24.0",
    "react-native-keychain": "^9.2.2",
    "react-native-mmkv": "^2.12.2",
    "react-native-razorpay": "^2.3.0",
    "react-native-reanimated": "3.16.7",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-vector-icons": "^10.2.0",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-flow": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native/babel-preset": "0.76.6",
    "@react-native/eslint-config": "0.76.6",
    "@react-native/metro-config": "0.76.6",
    "@react-native/typescript-config": "0.76.6",
    "@types/react": "^18.3.12",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.3.0",
    "@webos-tools/cli": "^3.2.5",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^9.2.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "css-loader": "^7.1.4",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.6.3",
    "postcss": "^8.5.23",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.3.3",
    "react-dom": "^18.3.1",
    "react-native-dotenv": "^3.4.11",
    "react-native-web": "^0.19.13",
    "react-test-renderer": "18.3.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "webpack": "^5.109.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "engines": {
    "node": ">=18"
  }
}
