<resources>
    <!--
      Full screen, no action bar. The window background is the Nexgen splash
      (charcoal + logo); the WebView stays transparent over it until the web app
      paints its own backdrop, so the wait looks like the app loading, not a
      blank white screen.
    -->
    <style name="Theme.NexgenHotels" parent="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/boot_splash</item>
    </style>
</resources>
