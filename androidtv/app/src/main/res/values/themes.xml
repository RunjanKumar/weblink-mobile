<resources>
    <!--
      Full screen, no action bar, dark: nothing on the way up is ever white. The
      window background is the Nexgen splash (black + logo); the page stays
      hidden over it until the first screen is painted (web/index.html), so the
      guest sees the logo and then the dashboard, nothing in between.
    -->
    <style name="Theme.NexgenHotels" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/boot_splash</item>
    </style>
</resources>
