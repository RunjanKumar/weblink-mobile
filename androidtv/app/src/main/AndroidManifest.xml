<?xml version="1.0" encoding="utf-8"?>
<!--
  Nexgen Hotels for Android TV: a WebView wrapper around the same TV web build
  LG (.ipk) and Samsung (.wgt) ship. See docs/android-tv/ANDROID_TV_PLAY_HANDOFF.md.

  Deliberately absent: QUERY_ALL_PACKAGES, REQUEST_INSTALL_PACKAGES and
  FOREGROUND_SERVICE*, each of which needs its own Play declaration.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hotel mode: open the app when the TV powers on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Hotel mode on Android 10+: the only way a boot receiver may start an activity. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- TV-only: Play lists the app on TVs and nowhere else. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Android 11+ package visibility: lets HotelMode read which app is the TV's Home. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!--
      No backup and no device-to-device transfer: the pairing token in the
      WebView's storage belongs to this one TV. Copied onto another device it
      would make two TVs answer for the same room.
    -->
    <application
        android:name=".NexgenApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexgenHotels">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- App list of AOSP "smart TVs" that have no Leanback launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hotel mode: the TV's Home app. Disabled until HotelMode.kt enables it. -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
          Hotel mode, power-on. LOCKED_BOOT_COMPLETED comes first and only to
          direct-boot-aware receivers, so it is fast (see EarlyBootReceiver).
        -->
        <!--
          Hotel mode runs in a small ":watch" process (see NexgenApplication): it
          survives low-memory kills that take the ~150 MB WebView process.
          An update stops both processes, and Play updates while the TV is in
          standby: MY_PACKAGE_REPLACED restarts the watcher, or the next wake
          would show the TV's Home until a restart.
        -->
        <receiver
            android:name=".WatchSyncReceiver"
            android:exported="false"
            android:process=":watch">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".EarlyBootReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:process=":watch">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Fallback. BOOT_COMPLETED reaches manifest receivers one at a time, highest
          priority first. A Xiaomi MiTV-MOOQ1 has 226 of them: at the default
          priority the app opened ~3 minutes after power-on.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:process=":watch">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
