{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    // "DOM" is needed by the `*.web.ts` shims (localStorage, Razorpay's
    // checkout.js global, the webOS remote's keydown handling). It is only
    // reachable from files webpack resolves for the web build — Metro never
    // bundles them — but it does mean tsc will not catch a stray `window` in
    // native code, so keep DOM usage inside `*.web.*` files.
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "src",
    "App.tsx",
    "index.js",
    "types/**/*.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "android", "ios", "babel.config.js", "metro.config.js"]
}
