# ─────────────────────────────────────────────────────────────
# Environment configuration (consumed via babel `react-native-dotenv`)
# Copy this file to `.env` and adjust per environment.
# NOTE: react-native-dotenv inlines these at BUILD time. After changing
# .env you must restart Metro with a cache reset: `npm run start:reset`.
# ─────────────────────────────────────────────────────────────

# Base URL for the REST API (no trailing slash).
API_BASE_URL=https://dev-hotel-api.wattinventive.com

# Socket.IO server (chat / realtime) — used from Phase 2 onwards.
SOCKET_URL=https://chat-hotel-automation.wattinventive.com

# Axios request timeout in milliseconds.
API_TIMEOUT=20000

# App environment label: development | staging | production
APP_ENV=development

# Asset host for the RELATIVE image paths the API returns (food/coupon/facility
# images). The backend stores e.g. "6a19.../food/x.jpg" — this prefix turns it
# into a loadable URL. Get it from the admin panel (copy any image address and
# keep only the part before the stored path).
IMAGE_BASE_URL=https://d36u10gu6pvj0x.cloudfront.net

# ── DEV ONLY: test-guest autofill on the Login screen ─────────────────────
# Inlined at BUILD time. Leave EMPTY for production builds — the runtime also
# gates on APP_ENV=development, but the strings would still land in the bundle.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
