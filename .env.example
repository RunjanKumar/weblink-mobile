# ─────────────────────────────────────────────────────────────
# Environment configuration (consumed via babel `react-native-dotenv`)
# Copy this file to `.env` and adjust per environment.
# NOTE: react-native-dotenv inlines these at BUILD time. After changing
# .env you must restart Metro with a cache reset: `npm run start:reset`.
# ─────────────────────────────────────────────────────────────

# Base URL for the REST API (no trailing slash).
API_BASE_URL=https://dev-hotel-api.wattinventive.com

# Socket.IO server (chat / realtime) — used from Phase 2 onwards.
SOCKET_URL=https://chat-hotel-automation.wattinventive.com

# Axios request timeout in milliseconds.
API_TIMEOUT=20000

# App environment label: development | staging | production
APP_ENV=development
