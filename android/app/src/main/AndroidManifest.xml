<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ── Android TV support ─────────────────────────────────────────────
         A TV has no touchscreen and uses the Leanback launcher. Declaring both
         features as NOT required means the SAME APK installs on phones, tablets
         AND Android TV. Do not make either required, or you lock out form factors.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">
        <!-- The launcher icon is the NexGen Automations mark (the same logo the
             TV footer carries as "POWERED BY"), generated into res/mipmap-* at
             all five densities from assests/NEXT GEN LOGO 2.png. It is in mipmap,
             not drawable, because launchers pull a HIGHER density than the
             device's own for the icon and only mipmap survives density stripping.
             The old @drawable/ic_launcher.xml was a placeholder bed motif.

             tv_banner is still an XML vector — replace it with a designed
             320x180 image before Play submission. -->
        <!-- Deliberately no mipmap-anydpi-v26 adaptive icon: the mark is a ~3:1
             wordmark, and an adaptive foreground must survive a circular mask
             that keeps only the middle 66%, which would clip "NEXGEN" at both
             ends. A legacy icon gets scaled INTO the mask instead of cropped, so
             the whole wordmark stays intact. -->

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="fullSensor"
            android:exported="true">

            <!-- Phone / tablet launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV (Leanback) launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
